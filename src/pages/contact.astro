---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import HelpdeskCard from "../components/HelpdeskCard.astro";
import JsonLd from "../components/JsonLd.astro";
import { SITE } from "../data/site";

const pageTitle = "Contact Official Helpdesk & Editorial Team — SSO Rajasthan";
const pageDescription =
  "Official phone numbers, email addresses, and support desks for Rajasthan SSO ID (sso.rajasthan.gov.in), plus editorial feedback for RajSSO Guide.";
const breadcrumbs = [{ name: "Contact & Support", url: `${SITE.url}/contact` }];
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/contact">
  <slot slot="head">
    <JsonLd
      title={pageTitle}
      description={pageDescription}
      canonicalUrl={`${SITE.url}/contact`}
      breadcrumbs={breadcrumbs}
    />
  </slot>

  <Breadcrumbs items={breadcrumbs} />

  <!-- Contact Header -->
  <section class="border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wider text-[var(--color-mute)] mb-3">
        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
        <span>GOVERNMENT DIRECTORY &amp; FEEDBACK</span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-semibold text-[var(--color-ink)] tracking-tight leading-tight">
        Contact &amp; Official Support Directory
      </h1>

      <p class="text-sm sm:text-base text-[var(--color-body)] mt-4 leading-relaxed">
        Whether you need official account assistance from the state government IT department or wish to suggest an editorial correction to our guide, all contact channels are listed below.
      </p>
    </div>
  </section>

  <!-- Helpdesk Directory Component -->
  <section class="py-12 bg-[var(--color-canvas-elevated)] border-b border-[var(--color-hairline)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-10">
      <HelpdeskCard />

      <!-- Official Office Address -->
      <div class="bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] p-6 sm:p-8 space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-[var(--radius-sm)] bg-[var(--color-ink)] text-[var(--color-on-primary)] flex items-center justify-center font-bold text-xs">
            HQ
          </div>
          <h2 class="text-base font-semibold text-[var(--color-ink)]">
            Official State IT Headquarters (DoIT&amp;C)
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-[var(--color-body)] leading-relaxed">
          Department of Information Technology &amp; Communication (DoIT&amp;C)<br />
          IT Building, Yojana Bhawan Campus, Tilak Marg, C-Scheme<br />
          Jaipur, Rajasthan — 302005, India
        </p>
        <p class="text-xs text-[var(--color-mute)] font-mono pt-1">
          Official State Web Portal: <a href="https://doitc.rajasthan.gov.in" target="_blank" rel="noopener noreferrer" class="text-[var(--color-link)] underline">doitc.rajasthan.gov.in</a>
        </p>
      </div>

      <!-- Editorial Feedback Form -->
      <div class="bg-[var(--color-canvas)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] p-6 sm:p-8 space-y-4">
        <div class="space-y-1">
          <span class="font-mono text-xs uppercase tracking-wider text-[var(--color-mute)] font-semibold">
            EDITORIAL DESK
          </span>
          <h2 class="text-lg font-semibold text-[var(--color-ink)]">
            Report an Error or Submit Feedback
          </h2>
          <p class="text-xs sm:text-sm text-[var(--color-body)]">
            Notice a broken link or a recent change in official government fees? Help us keep this guide accurate for Rajasthan citizens.
          </p>
        </div>

        <form
          action="https://formspree.io/f/placeholder"
          method="POST"
          class="space-y-4 pt-2 text-xs sm:text-sm"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block font-medium text-[var(--color-ink)] mb-1">Your Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Enter your name"
                class="w-full px-3 py-2 bg-[var(--color-canvas-elevated)] border border-[var(--color-hairline)] rounded-[var(--radius-sm)] text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-ink)]"
              />
            </div>
            <div>
              <label for="email" class="block font-medium text-[var(--color-ink)] mb-1">Your Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="your.email@example.com"
                class="w-full px-3 py-2 bg-[var(--color-canvas-elevated)] border border-[var(--color-hairline)] rounded-[var(--radius-sm)] text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-ink)]"
              />
            </div>
          </div>

          <div>
            <label for="topic" class="block font-medium text-[var(--color-ink)] mb-1">Topic / Guide</label>
            <select
              id="topic"
              name="topic"
              class="w-full px-3 py-2 bg-[var(--color-canvas-elevated)] border border-[var(--color-hairline)] rounded-[var(--radius-sm)] text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-ink)]"
            >
              <option value="general">General Suggestion</option>
              <option value="login-guide">SSO Login Guide Correction</option>
              <option value="registration-guide">Registration Guide Correction</option>
              <option value="recovery-guide">Password Recovery Correction</option>
              <option value="fee-update">Government Fee / Notification Update</option>
            </select>
          </div>

          <div>
            <label for="message" class="block font-medium text-[var(--color-ink)] mb-1">Message / Detail</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Describe the suggestion or question (Do NOT send passwords or OTPs)..."
              class="w-full px-3 py-2 bg-[var(--color-canvas-elevated)] border border-[var(--color-hairline)] rounded-[var(--radius-sm)] text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-ink)]"
            ></textarea>
          </div>

          <button
            type="submit"
            class="inline-flex items-center justify-center bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:bg-neutral-800 text-xs sm:text-sm font-medium h-10 px-6 rounded-full transition-all cursor-pointer"
          >
            Submit Feedback
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>
