---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: "website" | "article";
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonicalPath = Astro.url.pathname,
  type = "website",
} = Astro.props;

// Ensure clean canonical URL without trailing slashes (except root)
const cleanPath = canonicalPath === "/" ? "" : canonicalPath.replace(/\/$/, "");
const canonicalUrl = `${SITE.url}${cleanPath}`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="apple-touch-icon" href="/RajSSO/favicon_io/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/RajSSO/favicon_io/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={`${SITE.url}/images/rajasthan-sso-portal-overview.webp`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content="Rajasthan Single Sign-On SSO ID Portal Guide" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}/images/rajasthan-sso-portal-overview.webp`} />

    <!-- Google Fonts: Geist & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-canvas)] text-[var(--color-ink)] selection:bg-[var(--color-ink)] selection:text-[var(--color-on-primary)]">
    <Header currentPath={cleanPath || "/"} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
