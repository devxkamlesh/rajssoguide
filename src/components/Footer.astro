---
import { SITE, FOOTER_LINKS } from "../data/site";
---

<footer class="border-t border-[var(--color-hairline)] bg-[var(--color-canvas)] text-[var(--color-body)] transition-colors">
  <!-- Disclaimer Notice Band -->
  <div class="border-b border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] py-6 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-3.5 text-xs text-[var(--color-body)] leading-relaxed">
      <div class="inline-flex items-center gap-1.5 font-mono uppercase text-[11px] text-amber-900 bg-amber-50 border border-amber-300 px-2.5 py-1 rounded-[var(--radius-sm)] flex-shrink-0 font-medium">
        <svg class="w-3.5 h-3.5 text-amber-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Public Notice</span>
      </div>
      <p class="flex-1">
        {SITE.disclaimer}
      </p>
    </div>
  </div>

  <!-- Main Links Grid -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Col 1: About Platform -->
      <div class="md:col-span-1 space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-[var(--radius-sm)] bg-[var(--color-ink)] text-[var(--color-on-primary)] flex items-center justify-center font-bold text-xs">
            SSO
          </div>
          <span class="font-semibold text-[var(--color-ink)] tracking-tight">
            {SITE.name}
          </span>
        </div>
        <p class="text-xs text-[var(--color-mute)] leading-relaxed">
          An independent editorial platform dedicated to helping Rajasthan citizens, students, and businesses navigate the Single Sign-On (RajSSO) digital identity ecosystem.
        </p>
        <div class="pt-2 text-xs font-mono text-[var(--color-mute)] space-y-1">
          <p>Toll-Free: <span class="text-[var(--color-ink)] font-semibold">{SITE.support.helplineTollFree}</span></p>
          <p>Helpdesk: <span class="text-[var(--color-ink)] font-semibold">{SITE.support.generalHelpline}</span></p>
          <p>Email: <a href={`mailto:${SITE.support.email}`} class="text-[var(--color-link)] hover:underline">{SITE.support.email}</a></p>
        </div>
      </div>

      <!-- Col 2: Pillar Guides -->
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-[var(--color-ink)] font-semibold mb-4">
          Core Guides
        </p>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          {FOOTER_LINKS.guides.map((link) => (
            <li>
              <a href={link.href} class="text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Official Portals -->
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-[var(--color-ink)] font-semibold mb-4">
          Official State Portals
        </p>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          {FOOTER_LINKS.official.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors group"
              >
                <span>{link.label}</span>
                <span class="text-[10px] text-[var(--color-mute)] group-hover:text-[var(--color-ink)]">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Editorial & Legal -->
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-[var(--color-ink)] font-semibold mb-4">
          Information & Legal
        </p>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          {FOOTER_LINKS.company.map((link) => (
            <li>
              <a href={link.href} class="text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-[var(--color-hairline)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--color-mute)] font-mono">
      <div>
        © {new Date().getFullYear()} {SITE.domain}. All rights reserved.
      </div>
      <div class="flex items-center gap-4">
        <span>Reviewed &amp; {SITE.lastVerifiedLabel}</span>
        <span>•</span>
        <a href={SITE.author.url} target="_blank" rel="noopener noreferrer" aria-label={`Author portfolio: ${SITE.author.name}`} class="hover:text-[var(--color-ink)] transition-colors underline">
          By {SITE.author.name}
        </a>
      </div>
    </div>
  </div>
</footer>
