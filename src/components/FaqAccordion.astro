---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FaqItem[];
  title?: string;
  subtitle?: string;
}

const {
  faqs,
  title = "Frequently Asked Questions",
  subtitle = "Clear, verified answers regarding Rajasthan SSO ID procedures, recovery, and requirements.",
} = Astro.props;
---

<section class="py-12 sm:py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="mb-8">
      <div class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wider text-[var(--color-mute)] mb-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>VERIFIED ANSWERS</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-semibold text-[var(--color-ink)] tracking-tight">
        {title}
      </h2>
      <p class="text-sm text-[var(--color-body)] mt-1.5">
        {subtitle}
      </p>
    </div>

    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details class="group bg-[var(--color-canvas-elevated)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] overflow-hidden transition-all shadow-[0_1px_2px_rgba(0,0,0,0.02)]">
          <summary class="flex items-center justify-between p-4 sm:p-5 text-sm sm:text-base font-semibold text-[var(--color-ink)] cursor-pointer list-none select-none hover:bg-[var(--color-hairline-soft)]/50 transition-colors">
            <span class="flex items-center gap-3 pr-2">
              <span class="font-mono text-xs text-[var(--color-mute)] font-normal">Q{index + 1}</span>
              <span>{faq.question}</span>
            </span>
            <span class="ml-2 flex-shrink-0 text-[var(--color-mute)] transition-transform duration-200 group-open:rotate-180">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-4 sm:px-5 pb-5 pt-1 text-xs sm:text-sm text-[var(--color-body)] leading-relaxed border-t border-[var(--color-hairline)]/50">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
