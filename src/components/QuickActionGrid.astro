---
import { SITE } from "../data/site";
---

<section class="py-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 pb-3 border-b border-[var(--color-hairline)]">
      <div>
        <span class="font-mono text-xs uppercase tracking-wider text-[var(--color-mute)] font-semibold">
          DIRECT PORTAL ACCESS
        </span>
        <h2 class="text-xl sm:text-2xl font-semibold text-[var(--color-ink)] tracking-tight mt-0.5">
          Quick Action Gateway
        </h2>
      </div>
      <span class="text-xs font-mono text-[var(--color-mute)] mt-1 sm:mt-0">
        OFFICIAL DOMAIN: <strong class="text-[var(--color-ink)]">sso.rajasthan.gov.in</strong>
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      <!-- Card 1: SSO ID Login -->
      <div class="group relative bg-[var(--color-canvas-elevated)] border border-[var(--color-hairline)] hover:border-[var(--color-ink)] rounded-[var(--radius-md)] p-5 sm:p-6 transition-all shadow-[0_1px_2px_rgba(0,0,0,0.04)] hover:shadow-md flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-[var(--radius-sm)] bg-blue-50 dark:bg-blue-950/40 text-blue-600 border border-blue-100 dark:border-blue-900 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
            </svg>
          </div>
          <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--color-mute)]">PORTAL ENTRY</span>
          <h3 class="text-base font-semibold text-[var(--color-ink)] mt-0.5 mb-1.5">
            SSO ID Login
          </h3>
          <p class="text-xs text-[var(--color-body)] leading-relaxed mb-4">
            Direct sign-in for Citizens, State Employees, and Businesses accessing services.
          </p>
        </div>
        <div class="pt-3 border-t border-[var(--color-hairline)] flex items-center justify-between">
          <a href="/sso-id-login" aria-label="Read SSO ID login steps" class="text-xs font-medium text-[var(--color-link)] hover:underline flex items-center gap-1">
            Read Login Steps <span>→</span>
          </a>
          <a
            href={SITE.officialLoginUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Sign in to official Rajasthan SSO portal"
            class="inline-flex items-center gap-1 px-3 py-1 bg-[var(--color-ink)] text-[var(--color-on-primary)] rounded-[var(--radius-sm)] text-xs font-medium hover:bg-neutral-800 transition-colors"
          >
            <span>Sign In</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <!-- Card 2: SSO ID Registration -->
      <div class="group relative bg-[var(--color-canvas-elevated)] border border-[var(--color-hairline)] hover:border-[var(--color-ink)] rounded-[var(--radius-md)] p-5 sm:p-6 transition-all shadow-[0_1px_2px_rgba(0,0,0,0.04)] hover:shadow-md flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-[var(--radius-sm)] bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 border border-emerald-100 dark:border-emerald-900 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
            </svg>
          </div>
          <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--color-mute)]">NEW ACCOUNT</span>
          <h3 class="text-base font-semibold text-[var(--color-ink)] mt-0.5 mb-1.5">
            Registration
          </h3>
          <p class="text-xs text-[var(--color-body)] leading-relaxed mb-4">
            Create a lifetime digital ID via Jan Aadhaar (Citizen) or BRN (Udyog). 100% Free.
          </p>
        </div>
        <div class="pt-3 border-t border-[var(--color-hairline)] flex items-center justify-between">
          <a href="/sso-id-registration" aria-label="Read SSO ID registration steps" class="text-xs font-medium text-[var(--color-link)] hover:underline flex items-center gap-1">
            Read Registration Steps <span>→</span>
          </a>
          <a
            href={SITE.officialRegisterUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Register on official Rajasthan SSO portal"
            class="inline-flex items-center gap-1 px-3 py-1 bg-[var(--color-ink)] text-[var(--color-on-primary)] rounded-[var(--radius-sm)] text-xs font-medium hover:bg-neutral-800 transition-colors"
          >
            <span>Register</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <!-- Card 3: Forgot SSO ID & Password -->
      <div class="group relative bg-[var(--color-canvas-elevated)] border border-[var(--color-hairline)] hover:border-[var(--color-ink)] rounded-[var(--radius-md)] p-5 sm:p-6 transition-all shadow-[0_1px_2px_rgba(0,0,0,0.04)] hover:shadow-md flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-[var(--radius-sm)] bg-purple-50 dark:bg-purple-950/40 text-purple-600 border border-purple-100 dark:border-purple-900 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--color-mute)]">RECOVERY TOOL</span>
          <h3 class="text-base font-semibold text-[var(--color-ink)] mt-0.5 mb-1.5">
            Forgot SSO ID / Password
          </h3>
          <p class="text-xs text-[var(--color-body)] leading-relaxed mb-3">
            Lost access? Recover username via SMS code or reset password with mobile OTP.
          </p>
          <!-- 1-Click Copy SMS snippet -->
          <div class="bg-[var(--color-hairline-soft)] border border-[var(--color-hairline)] rounded-[var(--radius-sm)] px-2.5 py-1.5 mb-4 flex items-center justify-between text-[11px] font-mono text-[var(--color-ink)]">
            <span>SMS <strong>RJ SSO</strong> → 9223166166</span>
            <button
              type="button"
              id="copy-sms-btn"
              class="font-medium text-[var(--color-ink)] hover:bg-[var(--color-hairline)] border border-[var(--color-hairline)] bg-[var(--color-canvas)] px-2 py-0.5 rounded-[var(--radius-sm)] ml-1 cursor-pointer transition-colors shadow-xs"
              aria-label="Copy recovery SMS syntax RJ SSO"
              title="Copy SMS format"
            >
              Copy
            </button>
          </div>
        </div>
        <div class="pt-3 border-t border-[var(--color-hairline)] flex items-center justify-between">
          <a href="/forgot-sso-id" aria-label="Read forgot SSO ID password recovery steps" class="text-xs font-medium text-[var(--color-link)] hover:underline flex items-center gap-1">
            Read Recovery Steps <span>→</span>
          </a>
          <a
            href={SITE.officialForgotUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Reset password on official Rajasthan SSO portal"
            class="inline-flex items-center gap-1 px-3 py-1 bg-[var(--color-ink)] text-[var(--color-on-primary)] rounded-[var(--radius-sm)] text-xs font-medium hover:bg-neutral-800 transition-colors"
          >
            <span>Reset</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <!-- Card 4: e-Mitra Portal -->
      <div class="group relative bg-[var(--color-canvas-elevated)] border border-[var(--color-hairline)] hover:border-[var(--color-ink)] rounded-[var(--radius-md)] p-5 sm:p-6 transition-all shadow-[0_1px_2px_rgba(0,0,0,0.04)] hover:shadow-md flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-[var(--radius-sm)] bg-amber-50 dark:bg-amber-950/40 text-amber-700 border border-amber-200 dark:border-amber-900 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--color-mute)]">CITIZEN KIOSK</span>
          <h3 class="text-base font-semibold text-[var(--color-ink)] mt-0.5 mb-1.5">
            e-Mitra Rajasthan
          </h3>
          <p class="text-xs text-[var(--color-body)] leading-relaxed mb-4">
            Apply for Bonafide, Caste certificates, Discom power bills, and state revenue fees.
          </p>
        </div>
        <div class="pt-3 border-t border-[var(--color-hairline)] flex items-center justify-between">
          <span class="text-xs text-[var(--color-mute)] font-mono">500+ SERVICES</span>
          <a
            href={SITE.officialEmitraUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit official Rajasthan e-Mitra portal"
            class="inline-flex items-center gap-1 px-3 py-1 bg-[var(--color-ink)] text-[var(--color-on-primary)] rounded-[var(--radius-sm)] text-xs font-medium hover:bg-neutral-800 transition-colors"
          >
            <span>e-Mitra</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById("copy-sms-btn");
  copyBtn?.addEventListener("click", () => {
    navigator.clipboard.writeText("RJ SSO");
    copyBtn.innerText = "Copied!";
    setTimeout(() => {
      copyBtn.innerText = "Copy";
    }, 2000);
  });
</script>
