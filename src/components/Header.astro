---
import { NAV_LINKS, SITE } from "../data/site";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<header class="sticky top-0 z-50 bg-[var(--color-canvas)]/90 backdrop-blur-md border-b border-[var(--color-hairline)] transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" aria-label="SSO ID Rajasthan Portal Guide Home" class="flex items-center gap-2.5 group focus:outline-none">
      <div class="w-8 h-8 rounded-[var(--radius-sm)] bg-[var(--color-ink)] text-[var(--color-on-primary)] flex items-center justify-center font-bold text-sm tracking-tight transition-transform group-hover:scale-105">
        SSO
      </div>
      <div class="flex flex-col">
        <span class="font-semibold text-sm sm:text-base text-[var(--color-ink)] tracking-tight leading-tight flex items-center gap-1.5">
          {SITE.name}
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500" title="Independent & Verified Guide"></span>
        </span>
        <span class="font-mono text-[10px] text-[var(--color-mute)] uppercase tracking-wider">Rajasthan Portal</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main Navigation">
      {NAV_LINKS.map((item) => {
        const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-full text-sm font-medium transition-colors ${
              isActive
                ? "text-[var(--color-ink)] bg-[var(--color-canvas-elevated)] shadow-[0_1px_2px_rgba(0,0,0,0.05)] border border-[var(--color-hairline)]"
                : "text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-hairline-soft)]"
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-2.5">
      <a
        href={SITE.officialLoginUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Open official Rajasthan SSO Portal (sso.rajasthan.gov.in) in new tab"
        class="inline-flex items-center justify-center gap-1.5 bg-[var(--color-ink)] text-[var(--color-on-primary)] hover:bg-neutral-800 text-xs sm:text-sm font-medium h-9 px-4 rounded-full transition-all shadow-sm hover:shadow active:scale-98"
      >
        <span>Official Portal</span>
        <svg class="w-3.5 h-3.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle navigation menu"
        class="md:hidden p-2 rounded-[var(--radius-sm)] border border-[var(--color-hairline)] text-[var(--color-ink)] bg-[var(--color-canvas-elevated)] hover:bg-[var(--color-hairline-soft)] transition-colors focus:outline-none"
      >
        <svg id="menu-icon-open" class="w-5 h-5 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] px-4 py-3 space-y-1">
    {NAV_LINKS.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-[var(--radius-sm)] text-sm font-medium text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-elevated)] transition-colors"
      >
        {item.label}
      </a>
    ))}
    <div class="pt-2 border-t border-[var(--color-hairline)]">
      <a
        href={SITE.officialLoginUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between px-3 py-2 text-xs font-mono font-medium text-[var(--color-ink)] bg-[var(--color-canvas-elevated)] border border-[var(--color-hairline)] rounded-[var(--radius-sm)]"
      >
        <span>LAUNCH SSO.RAJASTHAN.GOV.IN</span>
        <span>↗</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-icon-open");
  const closeIcon = document.getElementById("menu-icon-close");

  btn?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    if (isHidden) {
      menu?.classList.remove("hidden");
      openIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
    } else {
      menu?.classList.add("hidden");
      openIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    }
  });
</script>
